[sub_resource type="Resource" id="Resource_hkgto"]
script = ExtResource("2_4libl")
text = "Nobody really knows...
Fragments of stories and tales of them...
...ruminate from time to time though.
I personally think they guy on the left...
looks strangely like one snail..."

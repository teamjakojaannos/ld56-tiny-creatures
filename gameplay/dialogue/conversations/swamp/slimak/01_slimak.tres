[sub_resource type="Resource" id="Resource_4cnko"]
script = ExtResource("2_xc2rv")
text = "Be careful, there’s many, many - anyway.
I used to be a rapper you know...
Until I took a, what was it again?
Anyway, I got sick beats yo!
Wanna hear ‘em?"

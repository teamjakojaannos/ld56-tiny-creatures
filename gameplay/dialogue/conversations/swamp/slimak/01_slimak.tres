[sub_resource type="Resource" id="Resource_x8vsl"]
script = ExtResource("2_xc2rv")
text = "My name is MC. MC Simlak.
Or was it Slimak?
Anyway. You’re in the swamp,
you boutta get - uhh, crunked.
The monster’s got a big stick, yo.
...
So, you like it?"
side = 1
speaker = ExtResource("3_3gwxe")

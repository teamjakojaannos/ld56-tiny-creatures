[sub_resource type="Resource" id="Resource_hwvr4"]
script = ExtResource("2_xa4nl")
text = "Phew! We got to my little home all safe and sound!"
side = 1
speaker = ExtResource("3_q6bg0")
metadata/_custom_type_script = "uid://v41h3cet8my1"

[sub_resource type="Resource" id="Resource_qkr7e"]
script = ExtResource("2_xa4nl")
text = "Alright, so what is going on?
Where am I? And why were you trapped in a lantern?"
speaker = ExtResource("4_sysit")
metadata/_custom_type_script = "uid://v41h3cet8my1"

[sub_resource type="Resource" id="Resource_c6arx"]
script = ExtResource("2_xa4nl")
text = "We are in my home! The spirit realm!
But recently something terrible happened...
A monster came to the realm... and they trapped me and my friends!"
side = 1
speaker = ExtResource("3_q6bg0")
metadata/_custom_type_script = "uid://v41h3cet8my1"

[sub_resource type="Resource" id="Resource_dknuq"]
script = ExtResource("2_xa4nl")
text = "That's tough. But I need to get home.
I have D&D at eight."
speaker = ExtResource("4_sysit")
metadata/_custom_type_script = "uid://v41h3cet8my1"

[sub_resource type="Resource" id="Resource_ndpfi"]
script = ExtResource("2_xa4nl")
text = "Listen! I really need your help!
I have seven friends who need saving..."
side = 1
speaker = ExtResource("3_q6bg0")
metadata/_custom_type_script = "uid://v41h3cet8my1"

[sub_resource type="Resource" id="Resource_sysit"]

[sub_resource type="Resource" id="Resource_m5o4x"]
script = ExtResource("2_q32xe")
text = "There's time to chat later! We need to get out of the forest!
So quit your yapping and let me out!"
side = 1
speaker = ExtResource("4_i50rk")
metadata/_custom_type_script = "uid://v41h3cet8my1"

[sub_resource type="Resource" id="Resource_w3qts"]

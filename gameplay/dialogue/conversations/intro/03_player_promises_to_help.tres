[sub_resource type="Resource" id="Resource_dxiow"]
script = ExtResource("2_q32xe")
text = "Oh! You're... a wisp!?
I have never seen one before... I thought they were just legends...
But why are you trapped?"
speaker = ExtResource("3_abt2k")
